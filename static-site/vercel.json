{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "www.antiqueehome.com" }], "destination": "https://antiqueehome.com/:path", "permanent": true },
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "antique-home-static.vercel.app" }], "destination": "https://antiqueehome.com/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/:path((?!api/)[^.]+)", "destination": "/:path.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpe?g|webp|gif|svg|ico|mp4|mp3|woff2?|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
